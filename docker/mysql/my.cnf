[mysqld]
# Tuned for a shared VPS with under 2GB of total RAM, not for throughput.
# MySQL's own defaults (128M buffer pool, performance_schema on, 151 max
# connections) assume a box with RAM to spare; this one does not.
innodb_buffer_pool_size = 96M
innodb_log_file_size = 32M
performance_schema = OFF
max_connections = 40
key_buffer_size = 8M
table_open_cache = 200
thread_cache_size = 4
